# OpenAI-compatible LLM (optional when using mock mode)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Force mock LLM (no network / no key needed)
AGENT_WB_MOCK=0

# Sandbox root for file tool (default: ./sandbox_data)
AGENT_WB_SANDBOX=./sandbox_data

# SQLite long-term memory path
AGENT_WB_MEMORY_DB=./data/memory.db

# Trace output directory
AGENT_WB_TRACE_DIR=./traces
